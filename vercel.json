{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/license/:action",
      "destination": "/api/license?action=:action"
    },
    {
      "source": "/((?!api/|assets/|fonts/|images/|sounds/|videos/|downloads/|favicon).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/|assets/|fonts/|images/|sounds/|videos/|downloads/|favicon).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}
